{
  "schema_version": "backup_failover_policy.v1",
  "owner": "platform-operations",
  "default_timezone": "UTC",
  "principles": [
    "Backups count only after checksum and restore verification.",
    "RPO and RTO are explicit for every protected target.",
    "Failover is manual and rehearsed before it is automated.",
    "Backups containing tenant data are classified data.",
    "Restore drill evidence is part of release evidence."
  ],
  "targets": [
    {
      "target_id": "postgres_primary",
      "description": "PostgreSQL metadata, tenant policies, registries, audit rows, migration history, and vector metadata.",
      "data_classes": ["internal", "personal", "confidential", "embedding", "ai_prompt", "ai_output"],
      "rpo_minutes": 15,
      "rto_hours": 4,
      "backup_methods": ["production_pitr_wal_archive", "daily_logical_dump", "development_pg_dump"],
      "retention": {
        "daily": 14,
        "weekly": 8,
        "monthly": 12
      },
      "restore_drill_frequency_days": 30,
      "integrity_checks": ["sha256_manifest", "pg_restore_catalog", "migration_checksum_verification", "audit_chain_verification"],
      "failover_mode": "manual promotion until HA ADR and production drills are passing",
      "current_dev_commands": ["docker compose run --rm backup", "docker compose run --rm backup-verify"]
    },
    {
      "target_id": "object_storage_records",
      "description": "Future office documents, mail attachments, WORM records, export packages, and audit snapshots.",
      "data_classes": ["public", "internal", "personal", "confidential", "gobd", "legal_hold", "voice_transcript"],
      "rpo_minutes": 60,
      "rto_hours": 8,
      "backup_methods": ["versioned_object_storage", "object_lock_retention", "cross_bucket_replication"],
      "retention": {
        "daily": 30,
        "weekly": 12,
        "monthly": 24
      },
      "restore_drill_frequency_days": 60,
      "integrity_checks": ["object_manifest_hash", "retention_policy_check", "legal_hold_check"],
      "failover_mode": "manual bucket endpoint switch until storage ADR is implemented",
      "current_dev_commands": []
    },
    {
      "target_id": "repository_and_configuration",
      "description": "Source code, migrations, infrastructure definitions, policy files, and release evidence.",
      "data_classes": ["internal"],
      "rpo_minutes": 1440,
      "rto_hours": 24,
      "backup_methods": ["git_remote", "signed_release_artifacts", "exported_policy_snapshot"],
      "retention": {
        "daily": 7,
        "weekly": 8,
        "monthly": 12
      },
      "restore_drill_frequency_days": 90,
      "integrity_checks": ["git_commit_hash", "migration_catalog_checksum", "policy_snapshot_hash"],
      "failover_mode": "restore from git remote and release artifacts",
      "current_dev_commands": ["git status --short", "docker compose run --rm quality"]
    }
  ],
  "incident_triggers": [
    "suspected database corruption",
    "migration checksum mismatch",
    "accidental tenant data modification or deletion",
    "audit chain verification failure",
    "object manifest verification failure",
    "RPO or RTO threshold at risk"
  ],
  "restore_drill_evidence": [
    "backup artifact name",
    "sha256 checksum",
    "operator",
    "date_utc",
    "source commit",
    "migration versions",
    "verification command output",
    "restore target",
    "approval reference"
  ]
}
