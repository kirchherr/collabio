{
  "$defs": {
    "GenOfficeRuntimeAuthorizationPayload": {
      "additionalProperties": false,
      "properties": {
        "authorization_id": {
          "title": "Authorization Id",
          "type": "string"
        },
        "change_control_ref": {
          "title": "Change Control Ref",
          "type": "string"
        },
        "corpus_manifest_hash": {
          "title": "Corpus Manifest Hash",
          "type": "string"
        },
        "engine_fixture_ids": {
          "items": {
            "type": "string"
          },
          "title": "Engine Fixture Ids",
          "type": "array"
        },
        "external_network_allowed": {
          "const": false,
          "default": false,
          "title": "External Network Allowed",
          "type": "boolean"
        },
        "hosted_service_allowed": {
          "const": false,
          "default": false,
          "title": "Hosted Service Allowed",
          "type": "boolean"
        },
        "issued_at_utc": {
          "format": "date-time",
          "title": "Issued At Utc",
          "type": "string"
        },
        "on_prem_distribution_allowed": {
          "const": false,
          "default": false,
          "title": "On Prem Distribution Allowed",
          "type": "boolean"
        },
        "payload_hash": {
          "title": "Payload Hash",
          "type": "string"
        },
        "persistent_document_write_allowed": {
          "const": false,
          "default": false,
          "title": "Persistent Document Write Allowed",
          "type": "boolean"
        },
        "preflight_only_fixture_ids": {
          "items": {
            "type": "string"
          },
          "title": "Preflight Only Fixture Ids",
          "type": "array"
        },
        "production_use_allowed": {
          "const": false,
          "default": false,
          "title": "Production Use Allowed",
          "type": "boolean"
        },
        "purpose": {
          "const": "synthetic_docx_fidelity_proof",
          "default": "synthetic_docx_fidelity_proof",
          "title": "Purpose",
          "type": "string"
        },
        "risk_acceptance_ref": {
          "title": "Risk Acceptance Ref",
          "type": "string"
        },
        "sandbox_profile_hash": {
          "title": "Sandbox Profile Hash",
          "type": "string"
        },
        "schema_version": {
          "const": "genoffice_runtime_authorization_payload.v1",
          "default": "genoffice_runtime_authorization_payload.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "signer_policy_hash": {
          "title": "Signer Policy Hash",
          "type": "string"
        },
        "source_import_allowed": {
          "const": false,
          "default": false,
          "title": "Source Import Allowed",
          "type": "boolean"
        },
        "synthetic_worker_execution_allowed": {
          "const": true,
          "default": true,
          "title": "Synthetic Worker Execution Allowed",
          "type": "boolean"
        },
        "tenant_content_allowed": {
          "const": false,
          "default": false,
          "title": "Tenant Content Allowed",
          "type": "boolean"
        },
        "valid_until_utc": {
          "format": "date-time",
          "title": "Valid Until Utc",
          "type": "string"
        },
        "worker_admission_report_hash": {
          "title": "Worker Admission Report Hash",
          "type": "string"
        },
        "worker_image_archive_sha256": {
          "title": "Worker Image Archive Sha256",
          "type": "string"
        },
        "worker_image_config_digest": {
          "title": "Worker Image Config Digest",
          "type": "string"
        },
        "worker_sbom_sha256": {
          "title": "Worker Sbom Sha256",
          "type": "string"
        },
        "worker_vulnerability_report_hash": {
          "title": "Worker Vulnerability Report Hash",
          "type": "string"
        }
      },
      "required": [
        "authorization_id",
        "issued_at_utc",
        "valid_until_utc",
        "risk_acceptance_ref",
        "change_control_ref",
        "signer_policy_hash",
        "worker_admission_report_hash",
        "worker_image_config_digest",
        "worker_image_archive_sha256",
        "worker_sbom_sha256",
        "worker_vulnerability_report_hash",
        "corpus_manifest_hash",
        "sandbox_profile_hash",
        "engine_fixture_ids",
        "preflight_only_fixture_ids",
        "payload_hash"
      ],
      "title": "GenOfficeRuntimeAuthorizationPayload",
      "type": "object"
    },
    "GenOfficeRuntimeDetachedApproval": {
      "additionalProperties": false,
      "properties": {
        "key_id": {
          "title": "Key Id",
          "type": "string"
        },
        "signature_base64": {
          "title": "Signature Base64",
          "type": "string"
        },
        "signer_id": {
          "title": "Signer Id",
          "type": "string"
        },
        "signer_role": {
          "enum": [
            "product_owner",
            "security_compliance_owner"
          ],
          "title": "Signer Role",
          "type": "string"
        }
      },
      "required": [
        "signer_id",
        "signer_role",
        "key_id",
        "signature_base64"
      ],
      "title": "GenOfficeRuntimeDetachedApproval",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approvals": {
      "items": {
        "$ref": "#/$defs/GenOfficeRuntimeDetachedApproval"
      },
      "title": "Approvals",
      "type": "array"
    },
    "payload": {
      "$ref": "#/$defs/GenOfficeRuntimeAuthorizationPayload"
    },
    "record_hash": {
      "title": "Record Hash",
      "type": "string"
    },
    "schema_version": {
      "const": "genoffice_runtime_authorization_envelope.v1",
      "default": "genoffice_runtime_authorization_envelope.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "payload",
    "approvals",
    "record_hash"
  ],
  "title": "GenOfficeRuntimeAuthorizationEnvelope",
  "type": "object"
}
