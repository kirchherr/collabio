{
  "$defs": {
    "GenOfficeInternalOssDecisionPayload": {
      "additionalProperties": false,
      "properties": {
        "apache_2_0_terms_accepted": {
          "title": "Apache 2 0 Terms Accepted",
          "type": "boolean"
        },
        "apache_notice_preservation_required": {
          "title": "Apache Notice Preservation Required",
          "type": "boolean"
        },
        "apache_patent_terms_acknowledged": {
          "title": "Apache Patent Terms Acknowledged",
          "type": "boolean"
        },
        "approved_source_scopes": {
          "items": {
            "type": "string"
          },
          "title": "Approved Source Scopes",
          "type": "array"
        },
        "approved_usage_profiles": {
          "items": {
            "type": "string"
          },
          "title": "Approved Usage Profiles",
          "type": "array"
        },
        "blocked_usage_profiles": {
          "items": {
            "type": "string"
          },
          "title": "Blocked Usage Profiles",
          "type": "array"
        },
        "change_control_ref": {
          "title": "Change Control Ref",
          "type": "string"
        },
        "decided_at_utc": {
          "format": "date-time",
          "title": "Decided At Utc",
          "type": "string"
        },
        "decision": {
          "enum": [
            "approved_for_development_evaluation",
            "rejected"
          ],
          "title": "Decision",
          "type": "string"
        },
        "decision_id": {
          "title": "Decision Id",
          "type": "string"
        },
        "dependency_license_resolutions": {
          "items": {
            "$ref": "#/$defs/GenOfficeInternalOssDependencyResolution"
          },
          "title": "Dependency License Resolutions",
          "type": "array"
        },
        "enterprise_scope_excluded": {
          "title": "Enterprise Scope Excluded",
          "type": "boolean"
        },
        "jszip_selected_license_expression": {
          "title": "Jszip Selected License Expression",
          "type": "string"
        },
        "legal_dossier_report_hash": {
          "title": "Legal Dossier Report Hash",
          "type": "string"
        },
        "pako_selected_license_expression": {
          "title": "Pako Selected License Expression",
          "type": "string"
        },
        "payload_hash": {
          "title": "Payload Hash",
          "type": "string"
        },
        "prohibited_source_scopes": {
          "items": {
            "type": "string"
          },
          "title": "Prohibited Source Scopes",
          "type": "array"
        },
        "reevaluation_triggers": {
          "items": {
            "type": "string"
          },
          "title": "Reevaluation Triggers",
          "type": "array"
        },
        "risk_acceptance_ref": {
          "title": "Risk Acceptance Ref",
          "type": "string"
        },
        "schema_version": {
          "const": "genoffice_internal_oss_decision_payload.v1",
          "default": "genoffice_internal_oss_decision_payload.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "third_party_notice_artifact_sha256": {
          "title": "Third Party Notice Artifact Sha256",
          "type": "string"
        },
        "third_party_notice_report_hash": {
          "title": "Third Party Notice Report Hash",
          "type": "string"
        },
        "trademark_policy": {
          "title": "Trademark Policy",
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "decision",
        "decided_at_utc",
        "risk_acceptance_ref",
        "change_control_ref",
        "legal_dossier_report_hash",
        "third_party_notice_report_hash",
        "third_party_notice_artifact_sha256",
        "approved_usage_profiles",
        "blocked_usage_profiles",
        "approved_source_scopes",
        "prohibited_source_scopes",
        "trademark_policy",
        "apache_2_0_terms_accepted",
        "apache_notice_preservation_required",
        "apache_patent_terms_acknowledged",
        "enterprise_scope_excluded",
        "jszip_selected_license_expression",
        "pako_selected_license_expression",
        "dependency_license_resolutions",
        "reevaluation_triggers",
        "payload_hash"
      ],
      "title": "GenOfficeInternalOssDecisionPayload",
      "type": "object"
    },
    "GenOfficeInternalOssDependencyResolution": {
      "additionalProperties": false,
      "properties": {
        "declared_license_expression": {
          "title": "Declared License Expression",
          "type": "string"
        },
        "legal_file_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Legal File Evidence Ids",
          "type": "array"
        },
        "package_name": {
          "title": "Package Name",
          "type": "string"
        },
        "package_version": {
          "title": "Package Version",
          "type": "string"
        },
        "selected_distribution_license_expression": {
          "title": "Selected Distribution License Expression",
          "type": "string"
        }
      },
      "required": [
        "package_name",
        "package_version",
        "declared_license_expression",
        "selected_distribution_license_expression",
        "legal_file_evidence_ids"
      ],
      "title": "GenOfficeInternalOssDependencyResolution",
      "type": "object"
    },
    "GenOfficeInternalOssDetachedApproval": {
      "additionalProperties": false,
      "properties": {
        "key_id": {
          "title": "Key Id",
          "type": "string"
        },
        "signature_base64": {
          "title": "Signature Base64",
          "type": "string"
        },
        "signer_id": {
          "title": "Signer Id",
          "type": "string"
        },
        "signer_role": {
          "enum": [
            "product_owner",
            "security_compliance_owner"
          ],
          "title": "Signer Role",
          "type": "string"
        }
      },
      "required": [
        "signer_id",
        "signer_role",
        "key_id",
        "signature_base64"
      ],
      "title": "GenOfficeInternalOssDetachedApproval",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approvals": {
      "items": {
        "$ref": "#/$defs/GenOfficeInternalOssDetachedApproval"
      },
      "title": "Approvals",
      "type": "array"
    },
    "payload": {
      "$ref": "#/$defs/GenOfficeInternalOssDecisionPayload"
    },
    "record_hash": {
      "title": "Record Hash",
      "type": "string"
    },
    "schema_version": {
      "const": "genoffice_internal_oss_decision_envelope.v1",
      "default": "genoffice_internal_oss_decision_envelope.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "payload",
    "approvals",
    "record_hash"
  ],
  "title": "GenOfficeInternalOssDecisionEnvelope",
  "type": "object"
}
