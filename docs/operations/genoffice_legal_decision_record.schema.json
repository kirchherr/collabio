      "title": "Dossier Report Hash",
      "type": "string"
    },
    "legal_opinion_ref": {
      "title": "Legal Opinion Ref",
      "type": "string"
    },
    "notice_distribution_artifact_sha256": {
      "title": "Notice Distribution Artifact Sha256",
