{
  "schema_version": "retention_manifest_policy.v1",
  "owner": "platform-retention",
  "default_timezone": "UTC",
  "policy_defaults": [
    {
      "retention_policy_id": "rp-temporary-7d",
      "description": "Short-lived temporary data such as previews and transient cache.",
      "classifications": ["public", "internal"],
      "source_object_types": ["document", "attachment", "comment", "wiki"],
      "lifecycle_states": ["working"],
      "retention_mode": "fixed_days",
      "retention_days": 7,
      "disposition_after_retention": "delete",
      "legal_hold_allowed": false,
      "worm_required": false,
      "object_lock_mode": "none",
      "storage_bucket_id": "working-objects",
      "cryptoshred_allowed_before_retention_end": false,
      "audit_required": false,
      "manifest_required": true
    },
    {
      "retention_policy_id": "rp-standard",
      "description": "Default working and saved-version retention for non-record source objects.",
      "classifications": ["public", "internal", "personal", "confidential"],
      "source_object_types": ["document", "mail", "attachment", "comment", "wiki", "procedure_doc"],
      "lifecycle_states": ["working", "saved_version", "restricted"],
      "retention_mode": "fixed_days",
      "retention_days": 365,
      "disposition_after_retention": "restrict",
      "legal_hold_allowed": true,
      "worm_required": false,
      "object_lock_mode": "none",
      "storage_bucket_id": "working-objects",
      "cryptoshred_allowed_before_retention_end": false,
      "audit_required": true,
      "manifest_required": true
    },
    {
      "retention_policy_id": "rp-restricted",
      "description": "Restricted confidential source objects pending lifecycle or review decisions.",
      "classifications": ["confidential", "personal"],
      "source_object_types": ["document", "mail", "attachment", "comment", "wiki", "procedure_doc"],
      "lifecycle_states": ["working", "saved_version", "restricted"],
      "retention_mode": "fixed_days",
      "retention_days": 1095,
      "disposition_after_retention": "restrict",
      "legal_hold_allowed": true,
      "worm_required": false,
      "object_lock_mode": "none",
      "storage_bucket_id": "working-objects",
      "cryptoshred_allowed_before_retention_end": false,
      "audit_required": true,
      "manifest_required": true
    },
    {
      "retention_policy_id": "rp-gobd-10y",
      "description": "GoBD-relevant business records and tax-relevant mail or document records.",
      "classifications": ["gobd"],
      "source_object_types": ["document", "mail", "attachment", "procedure_doc"],
      "lifecycle_states": ["business_record", "worm_evidence"],
      "retention_mode": "fixed_days",
      "retention_days": 3650,
      "disposition_after_retention": "delete_after_retention_if_no_hold",
      "legal_hold_allowed": true,
      "worm_required": true,
      "object_lock_mode": "compliance",
      "storage_bucket_id": "business-records",
      "cryptoshred_allowed_before_retention_end": false,
      "audit_required": true,
      "manifest_required": true
    },
    {
      "retention_policy_id": "rp-legal-hold",
      "description": "Records preserved for legal, audit, regulatory, or investigation matters until hold release.",
      "classifications": ["legal_hold", "gobd", "confidential", "personal"],
      "source_object_types": ["document", "mail", "attachment", "comment", "wiki", "procedure_doc"],
      "lifecycle_states": ["business_record", "worm_evidence", "restricted"],
      "retention_mode": "until_hold_release",
      "retention_days": null,
      "disposition_after_retention": "blocked_until_hold_release",
      "legal_hold_allowed": true,
      "worm_required": true,
      "object_lock_mode": "compliance",
      "storage_bucket_id": "evidence-records",
      "cryptoshred_allowed_before_retention_end": false,
      "audit_required": true,
      "manifest_required": true
    },
    {
      "retention_policy_id": "rp-ai-draft-365d",
      "description": "AI prompts, AI outputs, and voice transcripts retained as governed draft or interaction evidence.",
      "classifications": ["ai_prompt", "ai_output", "voice_transcript"],
      "source_object_types": ["document", "mail", "comment", "wiki", "procedure_doc"],
      "lifecycle_states": ["working", "saved_version", "restricted"],
      "retention_mode": "fixed_days",
      "retention_days": 365,
      "disposition_after_retention": "restrict",
      "legal_hold_allowed": true,
      "worm_required": false,
      "object_lock_mode": "none",
      "storage_bucket_id": "working-objects",
      "cryptoshred_allowed_before_retention_end": false,
      "audit_required": true,
      "manifest_required": true
    },
    {
      "retention_policy_id": "rp-parser-artifact-90d",
      "description": "Parser manifests, warnings, extracted text artifacts, and sandbox evidence.",
      "classifications": ["internal", "personal", "confidential"],
      "source_object_types": ["document", "mail", "attachment", "comment", "wiki", "procedure_doc"],
      "lifecycle_states": ["working", "saved_version", "restricted"],
      "retention_mode": "fixed_days",
      "retention_days": 90,
      "disposition_after_retention": "delete",
      "legal_hold_allowed": true,
      "worm_required": false,
      "object_lock_mode": "none",
      "storage_bucket_id": "parser-artifacts",
      "cryptoshred_allowed_before_retention_end": false,
      "audit_required": true,
      "manifest_required": true
    },
    {
      "retention_policy_id": "rp-embedding-follows-source",
      "description": "Vector chunks and embeddings inherit lifecycle from the authoritative source object.",
      "classifications": ["embedding", "rag_chunk"],
      "source_object_types": ["document", "mail", "attachment", "comment", "wiki", "procedure_doc"],
      "lifecycle_states": ["working", "saved_version", "restricted", "deleted", "cryptoshredded"],
      "retention_mode": "follows_source",
      "retention_days": null,
      "disposition_after_retention": "delete_or_reindex_with_source",
      "legal_hold_allowed": true,
      "worm_required": false,
      "object_lock_mode": "none",
      "storage_bucket_id": "working-objects",
      "cryptoshred_allowed_before_retention_end": false,
      "audit_required": true,
      "manifest_required": true
    },
    {
      "retention_policy_id": "rp-export-10y",
      "description": "E-discovery packages, audit packs, and forensic export artifacts.",
      "classifications": ["gobd", "legal_hold", "confidential", "personal"],
      "source_object_types": ["document", "mail", "attachment", "comment", "wiki", "procedure_doc"],
      "lifecycle_states": ["worm_evidence"],
      "retention_mode": "fixed_days",
      "retention_days": 3650,
      "disposition_after_retention": "export_review_required",
      "legal_hold_allowed": true,
      "worm_required": true,
      "object_lock_mode": "compliance",
      "storage_bucket_id": "evidence-records",
      "cryptoshred_allowed_before_retention_end": false,
      "audit_required": true,
      "manifest_required": true
    }
  ]
}
